generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}


model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model WishlistItem {
  id            Int      @id @default(autoincrement())
  shop          String
  customerId    String
  productId     String
  productHandle String
  productTitle  String
  productImage  String?
  productPrice  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, customerId, productId])
  @@index([shop, customerId])
}

model WishlistAnalytics {
  id        Int      @id @default(autoincrement())
  shop      String
  month     String
  day       String
  adds      Int      @default(0)
  removes   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([shop, day])
  @@index([shop, month])
}

model WishlistSettings {
  id              Int      @id @default(autoincrement())
  shop            String   @unique
  // Wishlist page
  heading         String   @default("My wishlist")
  emptyMessage    String   @default("You have not saved any products yet.")
  columns         Int      @default(4)
  showPrices      Boolean  @default(true)
  showRemove      Boolean  @default(true)
  buttonLabel     String   @default("Remove")
  showAddToCart   Boolean  @default(false)
  addToCartLabel  String   @default("Add to cart")
  cardClass       String   @default("sai-wishlist-page__item")
  customCss       String   @default("")
  // Toast notification
  toastBg         String   @default("#1a1a1a")
  toastColor      String   @default("#ffffff")
  toastPosition   String   @default("top-left")
  updatedAt     DateTime @updatedAt
}

model ActiveSubscription {
  id                   Int       @id @default(autoincrement())
  shop                 String    @unique
  planId               String    @default("free")
  subscriptionId       String?   // Shopify gid://shopify/AppSubscription/...
  status               String    @default("active") // active | pending | cancelled | expired
  trialEndsOn          DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model AddonPurchase {
  id             Int      @id @default(autoincrement())
  shop           String
  month          String   // "YYYY-MM" — addon applies only to this month
  saves          Int      // extra saves granted (e.g. 5000)
  price          Float    // amount charged (e.g. 5.00)
  chargeId       String?  // Shopify AppPurchaseOneTime GID
  status         String   @default("active") // active | pending
  createdAt      DateTime @default(now())

  @@index([shop, month])
}

model MonthlyPlanPurchase {
  id           Int      @id @default(autoincrement())
  shop         String
  month        String   // "YYYY-MM" — plan purchase applies only to this month
  planId       String
  billingId    String   @unique
  purchaseType String   @default("base")
  createdAt    DateTime @default(now())

  @@index([shop, month])
}

model ScheduledPlanChange {
  id             Int      @id @default(autoincrement())
  shop           String   @unique
  planId         String
  previousPlanId String
  effectiveMonth String   // "YYYY-MM"
  effectiveAt    DateTime?
  subscriptionId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PlanPurchaseHistory {
  id               Int      @id @default(autoincrement())
  shop             String
  planId           String
  purchaseType     String
  amount           Float
  eventKey         String   @unique
  subscriptionId   String?
  billingPeriodEnd DateTime?
  occurredAt       DateTime @default(now())

  @@index([shop, occurredAt])
  @@index([shop, subscriptionId, billingPeriodEnd])
}
