generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model WishlistItem {
  id            Int      @id @default(autoincrement())
  shop          String
  customerId    String
  productId     String
  productHandle String
  productTitle  String
  productImage  String?
  productPrice  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, customerId, productId])
  @@index([shop, customerId])
}

model WishlistAnalytics {
  id        Int      @id @default(autoincrement())
  shop      String
  month     String
  day       String
  adds      Int      @default(0)
  removes   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([shop, day])
  @@index([shop, month])
}

model WishlistSettings {
  id            Int      @id @default(autoincrement())
  shop          String   @unique
  // Wishlist page
  heading       String   @default("My wishlist")
  emptyMessage  String   @default("You have not saved any products yet.")
  columns       Int      @default(4)
  showPrices    Boolean  @default(true)
  showRemove    Boolean  @default(true)
  buttonLabel   String   @default("Remove")
  cardClass     String   @default("sai-wishlist-page__item")
  customCss     String   @default("")
  // Toast notification
  toastBg       String   @default("#1a1a1a")
  toastColor    String   @default("#ffffff")
  toastPosition String   @default("top-left")
  updatedAt     DateTime @updatedAt
}

model ActiveSubscription {
  id                   Int       @id @default(autoincrement())
  shop                 String    @unique
  planId               String    @default("free")
  subscriptionId       String?   // Shopify gid://shopify/AppSubscription/...
  status               String    @default("active") // active | pending | cancelled | expired
  trialEndsOn          DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model AddonPurchase {
  id             Int      @id @default(autoincrement())
  shop           String
  month          String   // "YYYY-MM" — addon applies only to this month
  saves          Int      // extra saves granted (e.g. 5000)
  price          Float    // amount charged (e.g. 5.00)
  chargeId       String?  // Shopify AppPurchaseOneTime GID
  status         String   @default("active") // active | pending
  createdAt      DateTime @default(now())

  @@index([shop, month])
}
