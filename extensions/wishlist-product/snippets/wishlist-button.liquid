{% doc %}
Renders a wishlist toggle for a product.
@param {product} [product]
{% enddoc %}

{{ 'wishlist.css' | asset_url | stylesheet_tag }}

{% assign wp = product %}

<div data-sai-wishlist>
  <button
    type="button"
    class="sai-wishlist"
    data-sai-wishlist-button
    data-product-id="{{ wp.id }}"
    data-product-handle="{{ wp.handle }}"
    data-product-title="{{ wp.title | escape }}"
    data-product-image="{{ wp.featured_image | image_url: width: 600 | escape }}"
    data-product-price="{{ wp.price | money | escape }}"
    aria-label="{{ 'wishlist.add_to_wishlist' | t }}"
  >
    <!-- Outline heart — shown when NOT saved -->
    <span class="sai-wishlist__icon sai-wishlist__icon--default" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em">
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
          stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <!-- Filled heart — shown when saved (.is-active on button) via CSS -->
    <span class="sai-wishlist__icon sai-wishlist__icon--active" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em">
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
      </svg>
    </span>
    <span class="sai-wishlist__label">{{ 'wishlist.add_to_wishlist' | t }}</span>
  </button>
</div>

<script>
  (() => {
    const storageKey = 'silverclouding_wishlist';
    const visitorStorageKey = 'silverclouding_wishlist_visitor';
    const syncEndpoint = '/apps/silverclouding-wishlist';
    const script = document.currentScript;
    const block = script && script.previousElementSibling;
    const button = block && block.querySelector('[data-sai-wishlist-button]');
    if (!button) return;

    // ── State ──────────────────────────────────────────────────────────────
    const productId    = button.dataset.productId;
    const productHandle = button.dataset.productHandle;
    const productTitle  = button.dataset.productTitle;
    const productImage  = button.dataset.productImage;
    const productPrice  = button.dataset.productPrice;
    let requestInFlight = false;
    let customerAuthenticated = false;

    // ── Helpers ────────────────────────────────────────────────────────────
    const getWishlist = () => {
      try { const v = JSON.parse(localStorage.getItem(storageKey) || '[]'); return Array.isArray(v) ? v : []; }
      catch { return []; }
    };
    const saveWishlist = (items) => {
      try { localStorage.setItem(storageKey, JSON.stringify(items)); } catch {}
      window.dispatchEvent(new CustomEvent('silverclouding:wishlist-updated'));
    };
    const getVisitorId = () => {
      let id = localStorage.getItem(visitorStorageKey);
      if (!id) { id = `${Date.now().toString(36)}-${Math.random().toString(36).slice(2,14)}`; localStorage.setItem(visitorStorageKey, id); }
      return id;
    };
    const updateView = (isSaved) => {
      button.classList.toggle('is-active', isSaved);
      // CSS handles icon via .is-active — just update the label
      const label = button.querySelector('.sai-wishlist__label');
      const savedLabel = {{ 'wishlist.saved' | t | json }};
      const addLabel = {{ 'wishlist.add_to_wishlist' | t | json }};
      if (label) label.textContent = isSaved ? savedLabel : addLabel;
      button.setAttribute('aria-label', isSaved ? savedLabel : addLabel);
    };
    const refresh = () => updateView(getWishlist().some((i) => String(i.id) === String(productId)));

    // ── Local fallback ─────────────────────────────────────────────────────
    const persistLocal = (operation, item) => {
      const items = getWishlist();
      const idx = items.findIndex((s) => String(s.id) === String(item.productId));
      if (operation === 'add' && idx < 0) items.push({ id: item.productId, handle: item.productHandle, title: item.productTitle, image: item.productImage || '', price: item.productPrice || '', addedAt: new Date().toISOString() });
      if (operation === 'remove' && idx >= 0) items.splice(idx, 1);
      saveWishlist(items);
      window.dispatchEvent(new CustomEvent('silverclouding:wishlist-toast', {
        detail: {
          message: operation === 'add' ? {{ 'wishlist.added_to_wishlist' | t | json }} : {{ 'wishlist.removed_from_wishlist' | t | json }}
        }
      }));
      return items;
    };

    // ── Sync ───────────────────────────────────────────────────────────────
    const sync = async (operation, item) => {
      if (!customerAuthenticated) {
        try {
          await fetch(syncEndpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin', body: JSON.stringify({ operation, visitorId: getVisitorId(), ...item }) });
        } catch {}
        return persistLocal(operation, item);
      }
      const res = await fetch(syncEndpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin', body: JSON.stringify({ operation, visitorId: getVisitorId(), ...item }) });
      // Handle monthly limit reached
      if (res.status === 429) {
        const d = await res.json().catch(() => ({}));
        if (operation !== 'add') return getWishlist();
        window.silvercloudingWishlistToast?.({ message: d.error || {{ 'wishlist.limit_reached' | t | json }} });
        return getWishlist();
      }
      if (!res.ok) { customerAuthenticated = false; return persistLocal(operation, item); }
      const data = await res.json();
      if (!Array.isArray(data.items)) { customerAuthenticated = false; return sync(operation, item); }
      const synced = data.items.map((s) => ({ id: s.productId, handle: s.productHandle, title: s.productTitle, image: s.productImage || '', price: s.productPrice || '', addedAt: s.createdAt }));
      saveWishlist(synced);
      window.dispatchEvent(new CustomEvent('silverclouding:wishlist-toast', {
        detail: {
          message: operation === 'add' ? {{ 'wishlist.added_to_wishlist' | t | json }} : {{ 'wishlist.removed_from_wishlist' | t | json }}
        }
      }));
      return synced;
    };

    // ── Initial sync ───────────────────────────────────────────────────────
    const initialSync = (() => {
      if (window.silvercloudingWishlistSyncPromise) return window.silvercloudingWishlistSyncPromise;
      const run = (async () => {
        const res = await fetch(syncEndpoint, { credentials: 'same-origin' }).catch(() => null);
        if (!res || !res.ok) { refresh(); return; }
        const data = await res.json();
        customerAuthenticated = data.authenticated === true;
        if (!data.authenticated || !Array.isArray(data.items)) { refresh(); return; }
        let synced = data.items.map((s) => ({ id: s.productId, handle: s.productHandle, title: s.productTitle, image: s.productImage || '', price: s.productPrice || '', addedAt: s.createdAt }));
        // Merge any local guest items into server
        for (const item of getWishlist()) {
          if (!synced.some((s) => String(s.id) === String(item.id))) {
            const merged = await sync('add', { productId: item.id, productHandle: item.handle, productTitle: item.title, productImage: item.image, productPrice: item.price });
            if (merged) synced = merged;
          }
        }
        saveWishlist(synced);
        refresh();
      })();
      window.silvercloudingWishlistSyncPromise = run.finally(() => { window.silvercloudingWishlistSyncPromise = null; });
      return window.silvercloudingWishlistSyncPromise;
    })();

    // ── Button click ───────────────────────────────────────────────────────
    button.addEventListener('click', async () => {
      if (requestInFlight) return;
      requestInFlight = true;
      button.disabled = true;
      try {
        await initialSync;
        const isSaved = getWishlist().some((i) => String(i.id) === String(productId));
        const synced = await sync(isSaved ? 'remove' : 'add', { productId, productHandle, productTitle, productImage, productPrice });
        if (synced) updateView(!isSaved);
      } catch (err) {
        console.error('Wishlist request failed', err);
        window.silvercloudingWishlistToast?.({ message: {{ 'wishlist.temporarily_unavailable' | t | json }} });
      } finally {
        button.disabled = false;
        requestInFlight = false;
      }
    });

    refresh();
    window.addEventListener('silverclouding:wishlist-updated', refresh);
    window.addEventListener('storage', (e) => { if (e.key === storageKey) refresh(); });
  })();
</script>
