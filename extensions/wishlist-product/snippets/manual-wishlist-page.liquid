{% doc %}
Renders the wishlist page container for the shared wishlist page script.
@param {string} [heading] - Wishlist heading
@param {string} [empty_message] - Message shown when the wishlist is empty
@param {number} [columns] - Number of desktop grid columns
@param {boolean} [show_prices] - Whether to show saved item prices
@param {boolean} [show_remove] - Whether to show remove buttons
@param {string} [button_label] - Remove button label
@param {boolean} [show_add_to_cart] - Whether to show add-to-cart buttons
@param {string} [add_to_cart_label] - Add-to-cart button label
{% enddoc %}

{% liquid
  assign wishlist_heading = heading | default: 'My wishlist'
  assign wishlist_empty_message = empty_message | default: 'You have not saved any products yet.'
  assign wishlist_columns = columns | default: 4
  assign wishlist_show_prices = show_prices | default: true, allow_false: true
  assign wishlist_show_remove = show_remove | default: true, allow_false: true
  assign wishlist_button_label = button_label | default: 'Remove'
  assign wishlist_show_add_to_cart = show_add_to_cart | default: false
  assign wishlist_add_to_cart_label = add_to_cart_label | default: 'Add to cart'
%}

<section
  class="sai-wishlist-page"
  data-sai-wishlist-page
  hidden
  style="--padding-block-start: 0px; --padding-block-end: 0px; --sai-image-ratio: 4 / 5;"
  data-setting-heading="{{ wishlist_heading | escape }}"
  data-setting-empty-msg="{{ wishlist_empty_message | escape }}"
  data-setting-columns="{{ wishlist_columns }}"
  data-setting-show-prices="{{ wishlist_show_prices }}"
  data-setting-show-remove="{{ wishlist_show_remove }}"
  data-setting-btn-label="{{ wishlist_button_label | escape }}"
  data-setting-show-atc="{{ wishlist_show_add_to_cart }}"
  data-setting-atc-label="{{ wishlist_add_to_cart_label | escape }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-currency="{{ cart.currency.iso_code }}"
  data-loc-sold-out="{{ 'wishlist.sold_out' | t | default: 'Sold out' | escape }}"
  data-loc-atc-error="{{ 'wishlist.add_to_cart_error' | t | default: 'Could not add this item to the cart' | escape }}"
  data-loc-added-cart="{{ 'wishlist.added_to_cart' | t | default: 'Added to cart' | escape }}"
  data-loc-removed="{{ 'wishlist.removed_from_wishlist' | t | default: 'Removed from wishlist' | escape }}"
  data-loc-cleared="{{ 'wishlist.wishlist_cleared' | t | default: 'Wishlist cleared' | escape }}"
  data-loc-limit="{{ 'wishlist.limit_reached' | t | default: 'Wishlist is temporarily unavailable' | escape }}"
>
  <div class="sai-wishlist-page__header">
    <div class="sai-wishlist-page__title-wrap">
      <h1 class="wislist-page-title">{{ wishlist_heading | escape }}</h1>
      <span class="sai-wishlist-page__count-badge" data-sai-wishlist-page-count style="display: none;"></span>
    </div>
    <div class="sai-wishlist-page__actions">
      <button type="button" class="sai-wishlist-page__share" data-sai-wishlist-share hidden style="display: none;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
        <span>{{ 'wishlist.share_wishlist' | t | default: 'Share' }}</span>
      </button>
      <button type="button" class="sai-wishlist-page__clear" data-sai-wishlist-clear hidden style="display: none;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
        <span>{{ 'wishlist.clear_all' | t | default: 'Clear all' }}</span>
      </button>
    </div>
  </div>

  <div class="sai-wishlist-page__empty-container" data-sai-wishlist-empty hidden style="display: none;">
    <div class="sai-wishlist-page__empty-icon">
      <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#FE847F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
      </svg>
    </div>
    <h3 class="sai-wishlist-page__empty-title">{{ wishlist_empty_message | escape }}</h3>
    <p class="sai-wishlist-page__empty-subtitle">Save your favorite products while you shop and find them all in one place.</p>
    <a href="{{ routes.all_products_collection_url }}" class="sai-wishlist-page__empty-btn">
      <span>Explore Products</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
    </a>
  </div>

  <div class="sai-wishlist-page__items" data-sai-wishlist-items style="display: none;"></div>
</section>
