{{ 'wishlist.css' | asset_url | stylesheet_tag }}

{% assign product_for_wishlist = block.settings.product | default: product %}

<div data-sai-wishlist>
  <button
    type="button"
    class="sai-wishlist"
    data-sai-wishlist-button
    data-product-id="{{ product_for_wishlist.id }}"
    data-product-handle="{{ product_for_wishlist.handle }}"
    data-product-title="{{ product_for_wishlist.title | escape }}"
    data-product-image="{{ product_for_wishlist.featured_image | image_url: width: 600 | escape }}"
    data-product-price="{{ product_for_wishlist.price | money | escape }}"
    data-block-id="{{ block.id }}"
  >
    <span class="sai-wishlist__icon" aria-hidden="true">♡</span>
    <span class="sai-wishlist__label">Add to wishlist</span>
  </button>
</div>

<script>
  (() => {
    const storageKey = 'saitriq_wishlist';
    const visitorStorageKey = 'saitriq_wishlist_visitor';
    const syncEndpoint = '/apps/saitriq-wishlist';
    const script = document.currentScript;
    const block = script && script.previousElementSibling;
    const button = block && block.querySelector('[data-sai-wishlist-button]');

    if (!button) return;

    const announce = (message) => {
      let toast = document.querySelector('[data-sai-wishlist-toast]');
      if (!toast) {
        toast = document.createElement('div');
        toast.dataset.saiWishlistToast = '';
        toast.className = 'sai-wishlist__toast';
        toast.setAttribute('role', 'status');
        document.body.append(toast);
      }
      toast.textContent = message;
      toast.classList.add('is-visible');
      clearTimeout(window.saitriqWishlistToastTimer);
      window.saitriqWishlistToastTimer = setTimeout(() => {
        toast.classList.remove('is-visible');
      }, 2200);
    };
    window.addEventListener('saitriq:wishlist-toast', (event) => {
      if (event.detail?.message) announce(event.detail.message);
    });

    const productId = button.dataset.productId;
    const productHandle = button.dataset.productHandle;
    const productTitle = button.dataset.productTitle;
    const productImage = button.dataset.productImage;
    const productPrice = button.dataset.productPrice;
    let buttonSettings = { buttonMode: 'icon-text', customSvg: '' };
    let requestInFlight = false;
    let customerAuthenticated = false;
    const renderIcon = (isSaved) => {
      const icon = button.querySelector('.sai-wishlist__icon');
      if (buttonSettings.buttonMode === 'custom-svg' && buttonSettings.customSvg) {
        icon.innerHTML = buttonSettings.customSvg;
      } else {
        icon.textContent = isSaved ? '♥' : '♡';
      }
      button.querySelector('.sai-wishlist__label').hidden =
        buttonSettings.buttonMode === 'icon-only';
    };
    const syncSettings = async () => {
      const response = await fetch(syncEndpoint, { credentials: 'same-origin' });
      if (!response.ok) return;
      const data = await response.json();
      customerAuthenticated = data.authenticated === true;
      buttonSettings = data.settings || buttonSettings;
      renderIcon(getWishlist().some((item) => String(item.id) === String(productId)));
    };

    const getWishlist = () => {
      try {
        const value = JSON.parse(localStorage.getItem(storageKey) || '[]');
        return Array.isArray(value) ? value : [];
      } catch (error) {
        console.error('Wishlist storage is unavailable', error);
        return [];
      }
    };

    const saveWishlist = (items) => {
      try {
        localStorage.setItem(storageKey, JSON.stringify(items));
        window.dispatchEvent(new CustomEvent('saitriq:wishlist-updated'));
      } catch (error) {
      }
    };

    const getVisitorId = () => {
      let visitorId = localStorage.getItem(visitorStorageKey);
      if (!visitorId) {
        visitorId = `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 14)}`;
        localStorage.setItem(visitorStorageKey, visitorId);
      }
      return visitorId;
    };

    const trackGuest = async (operation, item) => {
      try {
        const response = await fetch(syncEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ operation, visitorId: getVisitorId(), ...item })
        });
        const data = await response.json().catch(() => ({}));
        if (response.ok && data.tracked === true) return data;
        console.warn('Wishlist analytics tracking unavailable', response.status, data.error || '');
      } catch (error) {
        console.warn('Wishlist analytics tracking unavailable', error);
      }
      return null;
    };

    const sync = async (operation, item) => {
      if (!customerAuthenticated) {
        await trackGuest(operation, item);
        const items = getWishlist();
        const index = items.findIndex((saved) => String(saved.id) === String(item.productId));
        if (operation === 'add' && index < 0) items.push({
          id: item.productId,
          handle: item.productHandle,
          title: item.productTitle,
          image: item.productImage || '',
          price: item.productPrice || '',
          addedAt: new Date().toISOString()
        });
        if (operation === 'remove' && index >= 0) items.splice(index, 1);
        saveWishlist(items);
        window.dispatchEvent(new CustomEvent('saitriq:wishlist-toast', {
          detail: { message: operation === 'add' ? 'Added to wishlist' : 'Removed from wishlist' }
        }));
        return items;
      }
      const response = await fetch(syncEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ operation, visitorId: getVisitorId(), ...item })
      });
      if (!response.ok) {
        const errorBody = await response.text().catch(() => '');
        console.error(
          'Wishlist proxy request failed:',
          response.status,
          errorBody || '(empty response)',
          response.headers.get('X-Saitriq-Wishlist-Version') || '(no version header)'
        );
        customerAuthenticated = false;
        return sync(operation, item);
      }
      const data = await response.json();
      if (!Array.isArray(data.items)) {
        customerAuthenticated = false;
        return sync(operation, item);
      }
      const syncedItems = data.items.map((saved) => ({
        id: saved.productId,
        handle: saved.productHandle,
        title: saved.productTitle,
        image: saved.productImage || '',
        price: saved.productPrice || '',
        addedAt: saved.createdAt
      }));
      saveWishlist(syncedItems);
      window.dispatchEvent(new CustomEvent('saitriq:wishlist-toast', {
        detail: { message: operation === 'add' ? 'Added to wishlist' : 'Removed from wishlist' }
      }));
      return syncedItems;
    };

    const syncExistingItems = async () => {
      if (window.saitriqWishlistSyncPromise) {
        return window.saitriqWishlistSyncPromise;
      }

      const syncRun = (async () => {
      const response = await fetch(syncEndpoint, { credentials: 'same-origin' });
      if (!response.ok) return;
      const data = await response.json();
      customerAuthenticated = data.authenticated === true;
      if (!data.authenticated || !Array.isArray(data.items)) return;

      let syncedItems = data.items.map((saved) => ({
        id: saved.productId,
        handle: saved.productHandle,
        title: saved.productTitle,
        image: saved.productImage || '',
        addedAt: saved.createdAt
      }));

      for (const item of getWishlist()) {
        if (!syncedItems.some((saved) => String(saved.id) === String(item.id))) {
          const merged = await sync('add', {
            productId: item.id,
            productHandle: item.handle,
            productTitle: item.title,
            productImage: item.image
            ,productPrice: item.price
          });
          if (merged) syncedItems = merged;
        }
      }
      saveWishlist(syncedItems);
      refresh();
      syncSettings().catch(() => {});
      })();

      window.saitriqWishlistSyncPromise = syncRun.finally(() => {
        window.saitriqWishlistSyncPromise = null;
      });
      return window.saitriqWishlistSyncPromise;
    };

    const updateView = (isSaved) => {
      button.classList.toggle('is-active', isSaved);
      renderIcon(isSaved);
      button.querySelector('.sai-wishlist__label').textContent = isSaved ? 'Saved' : 'Add to wishlist';
    };

    const refresh = () => {
      const items = getWishlist();
      updateView(items.some((item) => String(item.id) === String(productId)));
    };

    refresh();
    const initialSync = syncExistingItems().catch(() => {
      console.error('Wishlist sync is temporarily unavailable');
    });
    window.addEventListener('saitriq:wishlist-updated', refresh);

    button.addEventListener('click', async () => {
      if (requestInFlight) return;
      requestInFlight = true;
      button.disabled = true;
      try {
        await initialSync;
        const wishlistItems = getWishlist();
        const existingIndex = wishlistItems.findIndex((item) => String(item.id) === String(productId));

        if (existingIndex >= 0) {
          const syncedItems = await sync('remove', {
            productId,
            productHandle,
            productTitle,
            productImage
          });
          if (syncedItems) updateView(false);
        } else {
          const syncedItems = await sync('add', {
            productId,
            productHandle,
            productTitle,
            productImage,
            productPrice
          });
          if (syncedItems) updateView(true);
        }
      } catch (error) {
        console.error('Wishlist request failed', error);
        announce('Wishlist is temporarily unavailable. Please try again.');
      } finally {
        button.disabled = false;
        requestInFlight = false;
      }
    });

    window.addEventListener('storage', (event) => {
      if (event.key === storageKey) refresh();
    });
  })();
</script>

{% schema %}
{
  "name": "Wishlist",
  "target": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "autofill": true
    }
  ]
}
{% endschema %}
