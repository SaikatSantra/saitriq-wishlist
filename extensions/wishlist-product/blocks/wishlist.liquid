{% assign product_for_wishlist = block.settings.product | default: product %}
{% assign btn_color = block.settings.button_color | default: '#1a1a1a' %}
{% assign btn_active_color = block.settings.active_color | default: '#1a1a1a' %}
{% assign icon_color = block.settings.icon_color | default: '#1a1a1a' %}
{% assign show_label = block.settings.show_label %}
{% assign label_add = block.settings.label_add | default: 'Add to wishlist' %}
{% assign label_saved = block.settings.label_saved | default: 'Saved' %}
{% assign custom_svg = block.settings.custom_svg %}

<div
  data-sai-wishlist
  data-product-id="{{ product_for_wishlist.id }}"
  data-product-handle="{{ product_for_wishlist.handle }}"
  data-product-title="{{ product_for_wishlist.title | escape }}"
  data-product-image="{{ product_for_wishlist.featured_image | image_url: width: 600 | escape }}"
  data-product-price="{{ product_for_wishlist.price | money | escape }}"
  data-product-variant-id="{{ product_for_wishlist.selected_or_first_available_variant.id }}"
  data-label-add="{{ label_add | escape }}"
  data-label-saved="{{ label_saved | escape }}"
  data-loc-added="{{ 'wishlist.added_to_wishlist' | t | escape }}"
  data-loc-removed="{{ 'wishlist.removed_from_wishlist' | t | escape }}"
  data-loc-limit="{{ 'wishlist.limit_reached' | t | escape }}"
  data-loc-error="{{ 'wishlist.temporarily_unavailable' | t | escape }}"
  style="
    --sai-btn-color: {{ btn_color }};
    --sai-btn-active-color: {{ btn_active_color }};
    --sai-icon-color: {{ icon_color }};
  "
>
  <button
    type="button"
    class="sai-wishlist button"
    data-sai-wishlist-button
    aria-label="{{ label_add | escape }}"
  >
    {% if custom_svg != blank %}
      <span class="sai-wishlist__icon sai-wishlist__icon--default" aria-hidden="true">
        {{ custom_svg }}
      </span>
      <span class="sai-wishlist__icon sai-wishlist__icon--active" aria-hidden="true" style="display:none">
        {{ custom_svg }}
      </span>
    {% else %}
      <span class="sai-wishlist__icon sai-wishlist__icon--default" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em">
          <path
            d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>
      <span class="sai-wishlist__icon sai-wishlist__icon--active" aria-hidden="true" style="display:none">
        <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      </span>
    {% endif %}

    {% if show_label %}
      <span class="sai-wishlist__label" data-sai-wishlist-label>{{ label_add | escape }}</span>
    {% endif %}
  </button>
</div>

{% schema %}
{
  "name": "Product Page Button",
  "target": "section",
  "javascript": "wishlist-product.js",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "autofill": true
    },
    {
      "type": "header",
      "content": "Button appearance"
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show text label",
      "default": true
    },
    {
      "type": "text",
      "id": "label_add",
      "label": "Label — not saved",
      "default": "Add to wishlist"
    },
    {
      "type": "text",
      "id": "label_saved",
      "label": "Label — saved",
      "default": "Saved"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button border & text color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "Button color when saved",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Custom icon (optional)"
    },
    {
      "type": "html",
      "id": "custom_svg",
      "label": "Custom SVG icon",
      "info": "Paste your SVG markup here. Leave empty to use the default heart icon."
    }
  ]
}
{% endschema %}