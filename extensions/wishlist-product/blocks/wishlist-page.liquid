{{ 'wishlist.css' | asset_url | stylesheet_tag }}

<section class="sai-wishlist-page" data-sai-wishlist-page>
  <div class="sai-wishlist-page__header">
    <h2>{{ block.settings.heading }}</h2>
    <button type="button" class="sai-wishlist-page__clear" data-sai-wishlist-clear hidden>
      Clear all
    </button>
    <p data-sai-wishlist-empty hidden>{{ block.settings.empty_message }}</p>
  </div>

  <div class=" grid main-collection-grid spacing-style" style="
    --grid--margin--mobile: 0 var(--margin-lg);
    --grid-column--desktop: var(--centered);
    --grid-column--mobile: var(--centered);
    --padding-inline-start: 0px;
    --padding-inline-end: 0px;
  ">

    <div style="
      grid-column: var(--full-width);
      --product-grid-gap-mobile: 12px 12px;
      --product-grid-gap-desktop: 16px 16px;
      container-name: product-grid;
    ">
      <ul class="sai-wishlist-page__items product-grid--grid product-grid " data-sai-wishlist-items></ul>
    </div>

  </div>
</section>

<script>
  (() => {
    const storageKey = 'saitriq_wishlist';
    const syncEndpoint = '/apps/saitriq-wishlist';
    let localRevision = 0;
    let settings = {
      heading: '{{ block.settings.heading | escape }}',
      emptyMessage: '{{ block.settings.empty_message | escape }}',
      columns: {{ block.settings.columns | default: 4 }},
      showPrices: {{ block.settings.show_prices | default: true | json }},
      showRemove: {{ block.settings.show_remove | default: true | json }},
      buttonLabel: '{{ block.settings.button_label | escape }}',
      cardClass: 'sai-wishlist-page__item',
      customCss: ''
    };
    const script = document.currentScript;
    const page = script && script.previousElementSibling;
    if (!page) return;

    const itemsContainer = page.querySelector('[data-sai-wishlist-items]');
    const emptyMessage = page.querySelector('[data-sai-wishlist-empty]');
    const clearButton = page.querySelector('[data-sai-wishlist-clear]');
    if (!itemsContainer || !emptyMessage || !clearButton) return;

    const getItems = () => {
      try {
        const items = JSON.parse(localStorage.getItem(storageKey) || '[]');
        return Array.isArray(items) ? items : [];
      } catch (error) {
        return [];
      }
    };

    const syncItems = async () => {
      if (window.saitriqWishlistSyncPromise) {
        return window.saitriqWishlistSyncPromise;
      }

      const syncRun = (async () => {
      const response = await fetch(syncEndpoint, { credentials: 'same-origin' });
      if (!response.ok) return;
      const data = await response.json();
      if (!data.authenticated || !Array.isArray(data.items)) return;
      if (data.settings) settings = { ...settings, ...data.settings };
      let customStyle = document.querySelector('[data-sai-wishlist-custom-css]');
      if (!customStyle) {
        customStyle = document.createElement('style');
        customStyle.dataset.saiWishlistCustomCss = '';
        document.head.append(customStyle);
      }
      customStyle.textContent = settings.customCss || '';

      let items = data.items.map((saved) => ({
        id: saved.productId,
        handle: saved.productHandle,
        title: saved.productTitle,
        image: saved.productImage || '',
        price: saved.productPrice || '',
        addedAt: saved.createdAt
      }));

      localStorage.setItem(storageKey, JSON.stringify(items));
      render();
      })();

      window.saitriqWishlistSyncPromise = syncRun.finally(() => {
        window.saitriqWishlistSyncPromise = null;
      });
      return window.saitriqWishlistSyncPromise;
    };

    const render = () => {
      const items = getItems();
      page.querySelector('h2').textContent = settings.heading;
      emptyMessage.textContent = settings.emptyMessage;
      itemsContainer.style.setProperty('--sai-wishlist-columns', settings.columns);
      itemsContainer.replaceChildren();
      emptyMessage.hidden = items.length > 0;
      clearButton.hidden = items.length === 0;

      items.forEach((item) => {
        const card = document.createElement('li');
        card.className = `sai-wishlist-page__item product-grid__item ${settings.cardClass || ''}`.trim();
        card.innerHTML = `
          <a href="/products/${encodeURIComponent(item.handle)}">
            <img data-sai-wishlist-image alt="" loading="lazy">
          </a>
          <div>
            <a class="sai-wishlist-page__title" href="/products/${encodeURIComponent(item.handle)}">${item.title || 'Product'}</a>
            ${settings.showPrices && item.price ? `<div class="sai-wishlist-page__price">${item.price}</div>` : ''}
            ${settings.showRemove ? `<button type="button" class="sai-wishlist-page__remove">${settings.buttonLabel}</button>` : ''}
          </div>
        `;
        const image = card.querySelector('[data-sai-wishlist-image]');
        image.alt = item.title || 'Product';
        image.src = item.image || `/products/${encodeURIComponent(item.handle)}.js`;
        image.addEventListener('error', async () => {
          if (image.dataset.fallbackAttempted) return;
          image.dataset.fallbackAttempted = 'true';
          try {
            const response = await fetch(`/products/${encodeURIComponent(item.handle)}.js`);
            if (!response.ok) return;
            const product = await response.json();
            const fallback = product.featured_image || product.images?.[0];
            if (fallback) image.src = fallback;
          } catch (error) {
            console.error('Wishlist image fallback failed', error);
          }
        }, { once: true });
        const removeButton = card.querySelector('.sai-wishlist-page__remove');
        if (!removeButton) {
          itemsContainer.append(card);
          return;
        }
        removeButton.addEventListener('click', async () => {
          removeButton.disabled = true;
          localRevision += 1;
          try {
            const response = await fetch(syncEndpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'same-origin',
              body: JSON.stringify({
                operation: 'remove',
                productId: item.id,
                productHandle: item.handle,
                productTitle: item.title,
                productImage: item.image
              })
            })
            if (!response.ok) {
              const errorBody = await response.text().catch(() => '');
              console.error('Wishlist remove proxy request failed', {
                status: response.status,
                body: errorBody,
                version: response.headers.get('X-Saitriq-Wishlist-Version')
              });
              throw new Error('Wishlist remove request failed');
            }
            const data = await response.json();
            if (!data.authenticated || !Array.isArray(data.items)) {
              throw new Error('Wishlist remove response was invalid');
            }
            const serverItems = data.items.map((saved) => ({
              id: saved.productId,
              handle: saved.productHandle,
              title: saved.productTitle,
              image: saved.productImage || '',
              price: saved.productPrice || '',
              addedAt: saved.createdAt
            }));
            localStorage.setItem(storageKey, JSON.stringify(serverItems));
            window.dispatchEvent(new CustomEvent('saitriq:wishlist-updated'));
            render();
          } catch (error) {
            emptyMessage.textContent = error.message;
            emptyMessage.hidden = false;
          } finally {
            removeButton.disabled = false;
          }
        });
        itemsContainer.append(card);
      });
    };

    clearButton.addEventListener('click', async () => {
      if (clearButton.disabled || getItems().length === 0) return;
      clearButton.disabled = true;
      localRevision += 1;
      try {
        const response = await fetch(syncEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ operation: 'clear' })
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.authenticated || !Array.isArray(data.items)) {
          console.error('Wishlist clear proxy request failed', {
            status: response.status,
            body: data
          });
          throw new Error(data.error || 'Wishlist clear request failed');
        }
        localStorage.setItem(storageKey, JSON.stringify(data.items));
        window.dispatchEvent(new CustomEvent('saitriq:wishlist-updated'));
        render();
      } catch (error) {
        emptyMessage.textContent = error.message;
        emptyMessage.hidden = false;
      } finally {
        clearButton.disabled = false;
      }
    });

    render();
    syncItems().catch(() => {});
    window.addEventListener('saitriq:wishlist-updated', render);
    window.addEventListener('storage', (event) => {
      if (event.key === storageKey) render();
    });
  })();
</script>

{% schema %}
{
  "name": "Wishlist page",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "My wishlist"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty wishlist message",
      "default": "You have not saved any products yet."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_prices",
      "label": "Show prices",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_remove",
      "label": "Show remove button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Remove button label",
      "default": "Remove"
    }
  ]
}
{% endschema %}
