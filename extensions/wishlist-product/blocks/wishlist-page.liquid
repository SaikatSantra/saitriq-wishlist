{% liquid
  assign block_settings = block.settings
  assign ratio = 1

  case block_settings.image_ratio
    when 'landscape'
      assign ratio = '16 / 9'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'square'
      assign ratio = '1 / 1'
  endcase

  if ratio == 0 or ratio == null
    assign ratio = 1
  endif
%}

<section 
  class="sai-wishlist-page" 
  data-sai-wishlist-page 
  hidden 
  style="
    --padding-block-start: {{ block.settings.padding-block-start }}px; 
    --padding-block-end: {{ block.settings.padding-block-end }}px;
    --sai-image-ratio: {{ ratio }};
  "
  data-setting-heading="{{ block.settings.heading | escape }}"
  data-setting-empty-msg="{{ block.settings.empty_message | escape }}"
  data-setting-columns="{{ block.settings.columns | default: 4 }}"
  data-setting-show-prices="{{ block.settings.show_prices | default: true }}"
  data-setting-show-remove="{{ block.settings.show_remove | default: true }}"
  data-setting-btn-label="{{ block.settings.button_label | escape }}"
  data-setting-show-atc="{{ block.settings.show_add_to_cart | default: false }}"
  data-setting-atc-label="{{ block.settings.add_to_cart_label | default: 'Add to cart' | escape }}"
  data-loc-sold-out="{{ 'wishlist.sold_out' | t | escape }}"
  data-loc-atc-error="{{ 'wishlist.add_to_cart_error' | t | escape }}"
  data-loc-added-cart="{{ 'wishlist.added_to_cart' | t | escape }}"
  data-loc-removed="{{ 'wishlist.removed_from_wishlist' | t | escape }}"
  data-loc-cleared="{{ 'wishlist.wishlist_cleared' | t | escape }}"
  data-loc-limit="{{ 'wishlist.limit_reached' | t | escape }}"
>
  <div class="sai-wishlist-page__header">
    <div class="sai-wishlist-page__title-wrap">
      <h1 class="wislist-page-title">{{ block.settings.heading | default: 'My Wishlist' }}</h1>
      <span class="sai-wishlist-page__count-badge" data-sai-wishlist-page-count></span>
    </div>
    <div class="sai-wishlist-page__actions">
      <button type="button" class="sai-wishlist-page__share" data-sai-wishlist-share hidden>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
        <span>{{ 'wishlist.share_wishlist' | t | default: 'Share' }}</span>
      </button>
      <button type="button" class="sai-wishlist-page__clear" data-sai-wishlist-clear hidden>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
        <span>{{ 'wishlist.clear_all' | t | default: 'Clear all' }}</span>
      </button>
    </div>
  </div>
  
  <div class="sai-wishlist-page__empty-container" data-sai-wishlist-empty hidden>
    <div class="sai-wishlist-page__empty-icon">
      <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#FE847F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
      </svg>
    </div>
    <h3 class="sai-wishlist-page__empty-title">{{ block.settings.empty_message | default: 'Your wishlist is empty' }}</h3>
    <p class="sai-wishlist-page__empty-subtitle">Save your favorite products while you shop and find them all in one place.</p>
    <a href="/collections/all" class="sai-wishlist-page__empty-btn">
      <span>Explore Products</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
    </a>
  </div>
  
  <div class="sai-wishlist-page__items" data-sai-wishlist-items></div>
</section>

{% schema %}
{
  "name": "Wishlist page",
  "target": "section",
  "stylesheet": "wishlist-page.css",
  "javascript": "wishlist-page.js",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "My wishlist"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty wishlist message",
      "default": "You have not saved any products yet."
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Aspect ratio",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_prices",
      "label": "Show prices",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_remove",
      "label": "Show remove button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Remove button label",
      "default": "Remove"
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show Add to cart button",
      "default": false
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart button label",
      "default": "Add to cart"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}