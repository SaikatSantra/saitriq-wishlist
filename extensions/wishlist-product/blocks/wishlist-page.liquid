{% liquid
  assign block_settings = block.settings
  assign ratio = 1

  case block_settings.image_ratio
    when 'landscape'
      assign ratio = '16 / 9'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'square'
      assign ratio = '1 / 1'
  endcase

  if ratio == 0 or ratio == null
    assign ratio = 1
  endif
%}

<section 
  class="sai-wishlist-page" 
  data-sai-wishlist-page 
  hidden 
  style="
    --padding-block-start: {{ block.settings.padding-block-start }}px; 
    --padding-block-end: {{ block.settings.padding-block-end }}px;
    --sai-image-ratio: {{ ratio }};
  "
  data-setting-heading="{{ block.settings.heading | escape }}"
  data-setting-empty-msg="{{ block.settings.empty_message | escape }}"
  data-setting-columns="{{ block.settings.columns | default: 4 }}"
  data-setting-show-prices="{{ block.settings.show_prices | default: true }}"
  data-setting-show-remove="{{ block.settings.show_remove | default: true }}"
  data-setting-btn-label="{{ block.settings.button_label | escape }}"
  data-setting-show-atc="{{ block.settings.show_add_to_cart | default: false }}"
  data-setting-atc-label="{{ block.settings.add_to_cart_label | default: 'Add to cart' | escape }}"
  data-loc-sold-out="{{ 'wishlist.sold_out' | t | escape }}"
  data-loc-atc-error="{{ 'wishlist.add_to_cart_error' | t | escape }}"
  data-loc-added-cart="{{ 'wishlist.added_to_cart' | t | escape }}"
  data-loc-removed="{{ 'wishlist.removed_from_wishlist' | t | escape }}"
  data-loc-cleared="{{ 'wishlist.wishlist_cleared' | t | escape }}"
>
  <div class="sai-wishlist-page__header">
    <h2 class="wislist-page-title h2">{{ block.settings.heading }}</h2>
    <div class="sai-wishlist-page__actions">
      <button type="button" class="sai-wishlist-page__share button" data-sai-wishlist-share hidden>
        Share wishlist
      </button>
      <button type="button" class="sai-wishlist-page__clear button" data-sai-wishlist-clear hidden>
        Clear all
      </button>
    </div>
  </div>
  
  <p data-sai-wishlist-empty hidden>{{ block.settings.empty_message }}</p>
  
  <div class="grid main-collection-grid spacing-style" style="
    --grid--margin--mobile: 0 var(--margin-lg);
    --grid-column--desktop: var(--centered);
    --grid-column--mobile: var(--centered);
    --padding-inline-start: 0px;
    --padding-inline-end: 0px;
  ">
    <div style="
      grid-column: var(--full-width);
      --product-grid-gap-mobile: 12px 12px;
      --product-grid-gap-desktop: 16px 16px;
      container-name: product-grid;
    ">
      <div class="sai-wishlist-page__items product-grid--grid product-grid" data-sai-wishlist-items></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wishlist page",
  "target": "section",
  "stylesheet": "wishlist-page.css",
  "javascript": "wishlist-page.js",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "My wishlist"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty wishlist message",
      "default": "You have not saved any products yet."
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Aspect ratio",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_prices",
      "label": "Show prices",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_remove",
      "label": "Show remove button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Remove button label",
      "default": "Remove"
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show Add to cart button",
      "default": false
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart button label",
      "default": "Add to cart"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}