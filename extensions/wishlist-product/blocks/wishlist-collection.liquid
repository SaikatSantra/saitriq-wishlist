{%- assign btn_color        = block.settings.button_color | default: '#ffffff' -%}
{%- assign btn_active_color = block.settings.active_color | default: '#ffffff' -%}
{%- assign icon_color       = block.settings.icon_color   | default: '#FE847F' -%}
{%- assign custom_svg       = block.settings.custom_svg -%}

<template 
  data-sai-collection-tpl
  data-label-add="{{ 'wishlist.add_to_wishlist' | t | escape }}"
  data-label-remove="{{ 'wishlist.remove_from_wishlist' | t | escape }}"
  data-msg-added="{{ 'wishlist.added_to_wishlist' | t | escape }}"
  data-msg-removed="{{ 'wishlist.removed_from_wishlist' | t | escape }}"
  data-msg-limit="{{ 'wishlist.limit_reached' | t | escape }}"
>
  <button
    type="button"
    class="sai-wishlist sai-wishlist--collection sai-wishlist--collection-{{ block.settings.position }}"
    data-sai-collection-wishlist
    aria-label="{{ 'wishlist.add_to_wishlist' | t | escape }}"
    style="
      --sai-btn-color: {{ btn_color }};
      --sai-btn-active-color: {{ btn_active_color }};
      --sai-icon-color: {{ icon_color }};
    "
  >
    {%- if custom_svg != blank -%}
      <span class="sai-wishlist__icon sai-wishlist__icon--default" aria-hidden="true">
        {{- custom_svg -}}
      </span>
      <span class="sai-wishlist__icon sai-wishlist__icon--active" aria-hidden="true">
        {{- custom_svg -}}
      </span>
    {%- else -%}
      <span class="sai-wishlist__icon sai-wishlist__icon--default " aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
            stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="sai-wishlist__icon sai-wishlist__icon--active" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      </span>
    {%- endif -%}
  </button>
</template>

{% schema %}
{
  "name": "Collection wishlist icons",
  "target": "section",
  "javascript": "wishlist-collection.js",
  "settings": [
    {
      "type": "header",
      "content": "Button appearance"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "Button background when saved",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#FE847F"
    },
    {
      "type": "header",
      "content": "Custom icon (optional)"
    },
    {
      "type": "html",
      "id": "custom_svg",
      "label": "Custom SVG icon",
      "info": "Paste your SVG markup here. Leave empty to use the default heart icon."
    },
    {
      "type": "select",
      "id": "position",
      "label": "Icon Position",
      "options": [
        {
          "value": "top-left",
          "label": "Top Left"
        },
        {
          "value": "top-right",
          "label": "Top Right"
        }
        
      ],
      "default": "top-right"
    }
  ]
}
{% endschema %}
