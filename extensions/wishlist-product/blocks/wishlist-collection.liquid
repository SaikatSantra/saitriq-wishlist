{% comment %}CSS loaded globally by the Saitriq Wishlist app embed block{% endcomment %}

<div data-sai-wishlist-collection></div>

<script>
  (() => {
    if (!window.saitriqEmbedEnabled) return; // app embed must be enabled in Theme Editor
    const storageKey = 'saitriq_wishlist';
    const visitorStorageKey = 'saitriq_wishlist_visitor';
    const endpoint = '/apps/saitriq-wishlist';
    let customerAuthenticated = false;
    const root = document.currentScript && document.currentScript.previousElementSibling;
    if (!root || window.saitriqWishlistCollectionLoaded) return;
    window.saitriqWishlistCollectionLoaded = true;

    const readItems = () => {
      try {
        const value = JSON.parse(localStorage.getItem(storageKey) || '[]');
        return Array.isArray(value) ? value : [];
      } catch {
        return [];
      }
    };

    const saveItems = (items) => {
      localStorage.setItem(storageKey, JSON.stringify(items));
      window.dispatchEvent(new CustomEvent('saitriq:wishlist-updated'));
    };

    const persistLocalFallback = (operation, item) => {
      const items = readItems();
      const index = items.findIndex((saved) => String(saved.id) === String(item.productId));
      if (operation === 'add' && index < 0) items.push({ ...toLocalItem(item), addedAt: new Date().toISOString() });
      if (operation === 'remove' && index >= 0) items.splice(index, 1);
      saveItems(items);
      window.dispatchEvent(new CustomEvent('saitriq:wishlist-toast', {
        detail: { message: operation === 'add' ? 'Added to wishlist' : 'Removed from wishlist' }
      }));
      return items;
    };

    const getVisitorId = () => {
      let visitorId = localStorage.getItem(visitorStorageKey);
      if (!visitorId) {
        visitorId = `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 14)}`;
        localStorage.setItem(visitorStorageKey, visitorId);
      }
      return visitorId;
    };

    const trackGuest = async (operation, item) => {
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ operation, visitorId: getVisitorId(), ...item })
        });
        const data = await response.json().catch(() => ({}));
        if (response.ok && data.tracked === true) return;
        console.warn('Wishlist analytics tracking unavailable', response.status, data.error || '');
      } catch (error) {
        console.warn('Wishlist analytics tracking unavailable', error);
      }
    };

    const productHandleFromLink = (link) => {
      const match = new URL(link.href, window.location.origin).pathname.match(/^\/products\/([^/]+)/);
      return match ? decodeURIComponent(match[1]) : '';
    };

    const productLinks = () => [...document.querySelectorAll('a[href*="/products/"]')]
      .filter((link) => productHandleFromLink(link))
      .filter((link, index, links) => links.findIndex((candidate) =>
        productHandleFromLink(candidate) === productHandleFromLink(link)
      ) === index);

    const productData = async (handle) => {
      if (productData._cache.has(handle)) return productData._cache.get(handle);
      const response = await fetch(`/products/${encodeURIComponent(handle)}.js`);
      if (!response.ok) throw new Error(`Product lookup failed: ${response.status}`);
      const product = await response.json();
      // Field names match what the proxy action expects (productId, productHandle, etc.)
      const data = {
        productId:     String(product.id),
        productHandle: product.handle,
        productTitle:  product.title,
        productImage:  product.featured_image || product.images?.[0] || '',
        productPrice:  product.price ? (product.price / 100).toFixed(2) : ''
      };
      productData._cache.set(handle, data);
      return data;
    };
    productData._cache = new Map();

    // Map proxy field names → localStorage shape for local fallback
    const toLocalItem = (item) => ({
      id:      item.productId,
      handle:  item.productHandle,
      title:   item.productTitle,
      image:   item.productImage || '',
      price:   item.productPrice || '',
    });

    const sync = async (operation, item) => {
      if (!customerAuthenticated) {
        await trackGuest(operation, item);
        return persistLocalFallback(operation, item);
      }
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ operation, visitorId: getVisitorId(), ...item })
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || !Array.isArray(data.items)) {
        console.warn('Wishlist proxy unavailable; using local fallback:', response.status, data.error || '(empty response)');
        customerAuthenticated = false;
        return persistLocalFallback(operation, item);
      }
      const items = data.items.map((saved) => ({
        id: saved.productId,
        handle: saved.productHandle,
        title: saved.productTitle,
        image: saved.productImage || '',
        price: saved.productPrice || '',
        addedAt: saved.createdAt
      }));
      saveItems(items);
      window.dispatchEvent(new CustomEvent('saitriq:wishlist-toast', {
        detail: { message: operation === 'add' ? 'Added to wishlist' : 'Removed from wishlist' }
      }));
      return items;
    };

    const render = (button, item) => {
      const saved = readItems().some((entry) => String(entry.id) === String(item.productId));
      button.textContent = saved ? '♥' : '♡';
      button.classList.toggle('is-active', saved);
      button.setAttribute('aria-label', saved ? 'Remove from wishlist' : 'Add to wishlist');
      button.title = saved ? 'Remove from wishlist' : 'Add to wishlist';
    };

    const detectAuthentication = async () => {
      const response = await fetch(endpoint, { credentials: 'same-origin' });
      const data = await response.json().catch(() => ({}));
      customerAuthenticated = data.authenticated === true;
      // Merge any locally saved items into the server for logged-in customers
      if (customerAuthenticated && Array.isArray(data.items)) {
        const serverIds = new Set(data.items.map((i) => String(i.productId)));
        const localOnly = readItems().filter((i) => !serverIds.has(String(i.id)));
        for (const local of localOnly) {
          fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({
              operation: 'add',
              visitorId: getVisitorId(),
              productId: local.id,
              productHandle: local.handle,
              productTitle: local.title,
              productImage: local.image,
              productPrice: local.price
            })
          }).catch(() => {});
        }
      }
    };

    const attach = async (link) => {
      const handle = productHandleFromLink(link);
      const card = link.closest('li, article, .card, .product-card, [class*="product-card"]');
      if (!handle || !card || card.querySelector('[data-sai-collection-wishlist]')) return;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'sai-wishlist sai-wishlist--collection';
      button.dataset.saiCollectionWishlist = '';
      button.textContent = '♡';
      button.addEventListener('click', async (event) => {
        event.preventDefault();
        event.stopPropagation();
        if (button.disabled) return;
        button.disabled = true;
        try {
          const item = await productData(handle);
          const saved = readItems().some((entry) => String(entry.id) === String(item.id));
          await sync(saved ? 'remove' : 'add', item);
          render(button, item);
        } catch (error) {
          console.error('Collection wishlist request failed', error);
        } finally {
          button.disabled = false;
        }
      });
      card.append(button);
      try {
        const item = await productData(handle);
        render(button, item);
      } catch (error) {
        button.remove();
        console.error('Collection wishlist product lookup failed', error);
      }
    };

    const scan = () => productLinks().forEach((link) => attach(link));
    detectAuthentication().finally(scan);
    new MutationObserver(scan).observe(document.body, { childList: true, subtree: true });
    window.addEventListener('saitriq:wishlist-updated', () => {
      // Re-render all buttons when wishlist changes (add/remove from another block)
      document.querySelectorAll('[data-sai-collection-wishlist]').forEach((btn) => {
        const card = btn.parentElement;
        const link = card && card.querySelector('a[href*="/products/"]');
        if (!link) return;
        const handle = productHandleFromLink(link);
        if (handle && productData._cache.has(handle)) render(btn, productData._cache.get(handle));
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Collection wishlist icons",
  "target": "section",
  "settings": []
}
{% endschema %}
