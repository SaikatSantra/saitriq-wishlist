{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm ci",
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "build/server/**",
        "build/client/**",
        "prisma/**"
      ],
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
